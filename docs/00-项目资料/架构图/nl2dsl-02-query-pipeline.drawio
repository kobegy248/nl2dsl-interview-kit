        <mxCell id="q_noteF" value="全链路每步写 state.trace（step/status/耗时/告警），供审计与 SSE 推送" style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#5B6B7F;fillColor=none;strokeColor=none;" vertex="1" parent="LF">
