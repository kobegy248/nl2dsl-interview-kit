        <mxCell id="q_end" value="END&lt;br&gt;data · sql · confidence · explanation · trace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.6;fontSize=12;fontColor=#1F2937;" vertex="1" parent="LF">
