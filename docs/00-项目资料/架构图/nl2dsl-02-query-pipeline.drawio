        <mxCell id="q_exp" value="explain_node&lt;br&gt;生成自然语言解释&lt;br&gt;→ state.explanation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.2;fontSize=11;fontColor=#1F2937;" vertex="1" parent="LF">
          <mxGeometry x="530" y="38" width="340" height="88" as="geometry" />
