          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. 候选 + CrossEncoder 精排 + 阈值 0.5 + 4000 字符预算" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
