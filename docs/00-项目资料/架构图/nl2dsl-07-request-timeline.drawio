            <mxPoint x="1390" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. JSON DSL（三级结构化输出 fallback）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6B656;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
