        <mxCell id="m4" value="4. graph.ainvoke(state, thread_id=&quot;sub_sq-1&quot;)　【简单意图直接进管道】" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
