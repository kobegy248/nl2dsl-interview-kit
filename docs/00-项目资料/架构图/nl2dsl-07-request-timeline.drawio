        <mxCell id="m5" value="5. retrieve_hybrid(query, top_k=5) — 4 集合：keywords 3 + 向量 coarse 10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
