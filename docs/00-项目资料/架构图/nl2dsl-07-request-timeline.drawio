        <mxCell id="m1" value="1. POST /api/v1/query {question, domain, user_id}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
