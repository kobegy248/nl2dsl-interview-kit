            <mxPoint x="1090" y="552" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="b1" value="9. 管道内部连续动作（无外部 IO）&lt;br&gt;validate_dsl → permission_check（注入行过滤）&lt;br&gt;→ resolve_semantic（值映射）→ optimize_dsl（28 条）&lt;br&gt;→ confidence（阈值 0.8 / 0.6）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F0F7F0;strokeColor=#82B366;fontSize=10.5;fontColor=#1F2937;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="600" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="10. 校验失败 → correct_dsl：错误提词 → 定向 RAG → 重生成（≤3 次）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B85450;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#B85450;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="702" as="sourcePoint" />
            <mxPoint x="1390" y="702" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="11. confidence &lt; 0.6 → 转澄清；0.6–0.8 → warning 继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6B656;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="744" as="sourcePoint" />
            <mxPoint x="790" y="744" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="b2" value="12. build_sql（SQLAlchemy Core + sqlglot 转译）&lt;br&gt;→ scan_sql（只读 / 单语句 / 禁注释）&lt;br&gt;→ sandbox_check（EXPLAIN 防全表扫 / 行数 / 超时）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FDF0EF;strokeColor=#B85450;fontSize=10.5;fontColor=#1F2937;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="950" y="756" width="280" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="13. 执行 SQL（已带 WHERE 租户 + 行级过滤 + LIMIT）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="856" as="sourcePoint" />
            <mxPoint x="1700" y="856" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="14. rows（≤ limit，超时中断）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1700" y="904" as="sourcePoint" />
            <mxPoint x="1090" y="904" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="15. verify_dsl（前 3 行样本自检）+ explain（人话解释）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D6B656;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="960" as="sourcePoint" />
            <mxPoint x="1390" y="960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="16. UPSERT nl2dsl_audit_log（query_id 主键，同步写）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1016" as="sourcePoint" />
            <mxPoint x="1700" y="1016" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="17. 返回 state：status / dsl / sql / data / explanation / confidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1090" y="1072" as="sourcePoint" />
            <mxPoint x="790" y="1072" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m16" value="18. SSE 事件流：plan / rag / dsl / sql / result / done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="1128" as="sourcePoint" />
            <mxPoint x="490" y="1128" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m17" value="19. 渲染表格 + SQL + 中文解释 + 置信度标签" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="490" y="1180" as="sourcePoint" />
            <mxPoint x="190" y="1180" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note1" value="复杂意图分支（对比 / 占比 / 关联 / 环比）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F5FB;strokeColor=#9673A6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#2B3A4A;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1256" width="1820" height="120" as="geometry" />
        </mxCell>
        <mxCell id="note1a" value="Controller 判定 complex → Planner 产出 ComplexPlan → dispatch_sub_queries 拆 2–3 个子查询&lt;br&gt;Phase 1：无依赖子查询 asyncio.gather 并发（信号量 MAX_PARALLEL_SUB_QUERIES=3），各自跑一遍上面全流程（独立 thread_id、独立 state）&lt;br&gt;Phase 2：有依赖的串行执行（如&quot;先查 Top 品类，再查这些品类的退货率&quot;）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="note1">
          <mxGeometry x="20" y="36" width="900" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note1b" value="Aggregate 6 种策略：diff / trend_direction / pearson / proportion / sequential_filter / ranking&lt;br&gt;单子查询失败 → 降级为部分结果 + error_code，不整单失败&lt;br&gt;置信度 = 各子查询平均；最终解释走模板拼接（复杂问题不再调 LLM）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7F5FB;strokeColor=#9673A6;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="note1">
          <mxGeometry x="940" y="36" width="860" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
