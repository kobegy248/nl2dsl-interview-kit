        <mxCell id="opt" value="优化器开关对比（同一批 44 用例，rule generator）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#2B3A4A;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1230" y="116" width="630" height="426" as="geometry" />
        </mxCell>
        <mxCell id="opt1" value="optimizer ON　→　81.6%（9 / 22 通过）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C6E0B4;strokeColor=#82B366;fontSize=12;fontStyle=1;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="opt">
          <mxGeometry x="20" y="42" width="590" height="34" as="geometry" />
        </mxCell>
        <mxCell id="opt2" value="optimizer OFF　→　81.6%（9 / 22 通过）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C6E0B4;strokeColor=#82B366;fontSize=12;fontStyle=1;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="opt">
          <mxGeometry x="20" y="84" width="590" height="34" as="geometry" />
        </mxCell>
        <mxCell id="opt3" value="差值 = 0.0 个百分点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;fontStyle=1;fontColor=#B85450;align=center;" vertex="1" parent="opt">
          <mxGeometry x="20" y="126" width="590" height="34" as="geometry" />
        </mxCell>
        <mxCell id="opt4" value="原因：optimizer_stats 显示 avg_fixes = 0.0，avg_rejections = 0.0，&lt;br&gt;avg_warnings = 0.14 —— 这批样本的 DSL 本身就已经规范，&lt;br&gt;28 条规则几乎没有触发，所以开关无差异。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="opt">
          <mxGeometry x="20" y="172" width="590" height="76" as="geometry" />
        </mxCell>
        <mxCell id="opt5" value="这意味着：现有评测不能证明优化器有效，&lt;br&gt;要证明它，必须专门构造&quot;脏 DSL&quot;样本（缺 alias、&lt;br&gt;SUM 套 SUM、limit 越界、枚举值写错、冗余 JOIN）&lt;br&gt;—— 这是评测集的缺口，不是优化器的缺口。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="opt">
          <mxGeometry x="20" y="260" width="590" height="86" as="geometry" />
        </mxCell>
        <mxCell id="opt6" value="另一个佐证：2026-06-20 那批（55 用例）不做规则注入时是 92.6%，&lt;br&gt;说明分数主要由样本难度决定，而不是由优化器决定。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#334155;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="opt">
          <mxGeometry x="20" y="356" width="590" height="52" as="geometry" />
        </mxCell>

