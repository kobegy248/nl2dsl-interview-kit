          <mxGeometry x="40" y="660" width="142" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="result_accuracy&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;权重 10%&lt;/font&gt;&lt;br&gt;&lt;b&gt;37.0%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4B6B6;strokeColor=#B85450;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="190" y="660" width="142" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d10" value="permission&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;权重 4%&lt;/font&gt;&lt;br&gt;&lt;b&gt;100.0%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9D08E;strokeColor=#82B366;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="340" y="660" width="142" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d11" value="masking&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;权重 3%&lt;/font&gt;&lt;br&gt;&lt;b&gt;100.0%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#A9D08E;strokeColor=#82B366;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="490" y="660" width="142" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d12" value="audit&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;权重 3%&lt;/font&gt;&lt;br&gt;&lt;b&gt;0.0%&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4B6B6;strokeColor=#B85450;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="640" y="660" width="142" height="64" as="geometry" />
        </mxCell>
        <mxCell id="d13" value="说明：masking 100% 是评测口径分（检查脱敏规则是否存在），&lt;br&gt;不等于运行时真的脱敏了 —— 主链路还没接 mask()。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;fontSize=10.5;fontColor=#334155;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="660" width="292" height="64" as="geometry" />
        </mxCell>

        <mxCell id="cn" value="从这张图能读出的 6 件事" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#9AA7B8;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#2B3A4A;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="752" width="1080" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cn1" value="① metric 在三个域都是 100%：语义层 + 术语表 + 指标注册表这条链路是这一版最稳的一环。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF6EA;strokeColor=#82B366;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="42" width="1040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cn2" value="② intent 95.5% / 98.2%（ecommerce）：7 类配置化意图 + 关键词规则已经够用，不需要更重的模型。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EAF6EA;strokeColor=#82B366;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="80" width="1040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cn3" value="③ planner 56.6% 是 ecommerce 的最短板：JOIN 推断（跨表 6 条全失败）与多跳问题是主要失分点。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF0EF;strokeColor=#B85450;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="118" width="1040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cn4" value="④ bank 全域 50% 且五维同分：execution_errors = 5，失败发生在执行层，把所有维度一起拉平 —— 这不是语义问题。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="156" width="1040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cn5" value="⑤ 优化器 on/off 完全一致（avg_fixes=0）：现有样本测不出优化器的价值，需要补&quot;脏 DSL&quot;用例集。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="194" width="1040" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cn6" value="⑥ 12 维里 result_accuracy 37%、audit 0% 是真实短板；前者是结果比对口径问题，后者是审计未进评测链路。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF0EF;strokeColor=#B85450;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=12;" vertex="1" parent="cn">
          <mxGeometry x="20" y="232" width="1040" height="32" as="geometry" />
        </mxCell>

        <mxCell id="caveat" value="使用边界（别被分数骗）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F4F5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#2B3A4A;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1140" y="752" width="720" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cv1" value="· 全部是历史快照，不是线上指标；仓库里没有持续跑的 CI 门禁。&lt;br&gt;· 各批样本量不同（10 / 44 / 50 / 55），单条用例在 bank 域占 10 个百分点。&lt;br&gt;· 12 维与 V2 五维是两套口径，不能直接相加或换算。&lt;br&gt;· 2026-06-01 那批跑的是真实 LLM 链路；部分 V2 批次延迟为 0.0 ms，&lt;br&gt;　　说明是规则生成路径（未真实调用 LLM），不能用来评价模型效果。&lt;br&gt;· masking 100% 是&quot;规则存在性&quot;检查，不代表运行时已脱敏。&lt;br&gt;· 面试口径：说&quot;我搭了评测体系并能跑通真实链路&quot;，不要说&quot;准确率 92%&quot;。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10.5;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="caveat">
          <mxGeometry x="20" y="42" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cv2" value="下一步最该补的三件事：&lt;br&gt;1) 以 92.6% 那批为基线，固定 dataset_hash 做回归门禁&lt;br&gt;2) 构造 30 条&quot;脏 DSL&quot;用例，专门测 28 条规则&lt;br&gt;3) 把 join / cross_table / having 失败样例做成专项集，盯 planner" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10.5;fontColor=#1F2937;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="caveat">
          <mxGeometry x="20" y="202" width="680" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
